template <typename Model>
struct ContactModel6DLoopVisitor
    : public bp::def_visitor<ContactModel6DLoopVisitor<Model>> {
  typedef typename Model::StateMultibody State;
  typedef typename Model::SE3 SE3;
  typedef typename Model::Vector2s Vector2s;
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def(bp::init<std::shared_ptr<State>, int, SE3, int, SE3,
                    pinocchio::ReferenceFrame, std::size_t, bp::optional<Vector2s>>(
               bp::args("self", "state", "joint1_id", "joint1_placement", "joint2_id", "joint2_placement", "type", "nu", "gains"),
               "Initialize the 6D loop contact model."))
        .def("calc", &Model::calc, bp::args("self", "data", "x"),
             "Compute the 6D loop contact Jacobian and drift.")
        .def("calcDiff", &Model::calcDiff, bp::args("self", "data", "x"),
             "Compute the derivatives of the 6D loop contact holonomic constraint.")
        .def("updateForce", &Model::updateForce, bp::args("self", "data", "force"),
             "Convert the Lagrangian into a stack of spatial forces.")
        .def("createData", &Model::createData, bp::with_custodian_and_ward_postcall<0, 2>(),
             bp::args("self", "data"),
             "Create the 6D loop contact data.")
        .add_property("joint1_id", &Model::get_joint1_id)
        .add_property("joint1_placement", bp::make_function(&Model::get_joint1_placement, bp::return_internal_reference<>()))
        .add_property("joint2_id", &Model::get_joint2_id)
        .add_property("joint2_placement", bp::make_function(&Model::get_joint2_placement, bp::return_internal_reference<>()))
        .add_property("gains", bp::make_function(&Model::get_gains, bp::return_value_policy<bp::return_by_value>()));
  }
};

template <typename Data>
struct ContactData6DLoopVisitor
    : public bp::def_visitor<ContactData6DLoopVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property("v1_partial_dq", bp::make_getter(&Data::v1_partial_dq, bp::return_internal_reference<>()))
        .add_property("a1_partial_dq", bp::make_getter(&Data::a1_partial_dq, bp::return_internal_reference<>()))
        .add_property("a1_partial_dv", bp::make_getter(&Data::a1_partial_dv, bp::return_internal_reference<>()));
  }
};

#define CROCODDYL_CONTACT_MODEL_6D_LOOP_PYTHON_BINDINGS(Scalar)               \
  typedef ContactModel6DLoopTpl<Scalar> Model;                               \
  typedef ContactModelAbstractTpl<Scalar> ModelBase;                         \
  typedef Model::StateMultibody State;                                       \
  typedef Model::SE3 SE3;                                                    \
  typedef Model::Vector2s Vector2s;                                          \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                      \
  bp::class_<Model, bp::bases<ModelBase>>(                                   \
      "ContactModel6DLoop",                                                \
      "Rigid 6D loop contact model.\n\n"                                      \
      "It defines a rigid 6D loop contact model based on acceleration-based " \
      "holonomic constraints. The calc and calcDiff functions compute the "   \
      "contact Jacobian and drift (holonomic constraint) or the derivatives " \
      "of the holonomic constraint, respectively.",                           \
      bp::init<std::shared_ptr<State>, int, SE3, int, SE3,                   \
               pinocchio::ReferenceFrame, std::size_t,                       \
               bp::optional<Vector2s>>(                                      \
          bp::args("self", "state", "joint1_id", "joint1_placement", \
                   "joint2_id", "joint2_placement", "type", "nu",    \
                   "gains"),                                              \
          "Initialize the 6D loop contact model.\n\n"                        \
          ":param state: state of the multibody system\n"                     \
          ":param joint1_id: parent joint id of the first contact\n"         \
          ":param joint1_placement: placement of the first contact\n"        \
          ":param joint2_id: parent joint id of the second contact\n"        \
          ":param joint2_placement: placement of the second contact\n"       \
          ":param type: type of contact\n"                                    \
          ":param nu: dimension of control vector\n"                          \
          ":param gains: gains of the contact model (default "                \
